<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Assistive Access runs the app full screen: its screens are
	     already one action each with big buttons (docs/accessibility.md). -->
	<key>UISupportsFullScreenInAssistiveAccess</key>
	<true/>
	<!-- Brand type, bundled in CheckWithUs/Fonts (OFL). Font.brand and Font.display in AppTheme.swift use them. -->
	<key>UIAppFonts</key>
	<array>
		<string>Figtree-Regular.ttf</string>
		<string>Figtree-SemiBold.ttf</string>
		<string>Figtree-Bold.ttf</string>
		<string>Figtree-ExtraBold.ttf</string>
		<string>Gabarito-SemiBold.ttf</string>
		<string>Gabarito-ExtraBold.ttf</string>
	</array>
</dict>
</plist>
