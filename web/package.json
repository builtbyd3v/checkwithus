{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:db": "node --env-file=.env.local scripts/check-db.mjs",
    "check:nessie": "node --env-file=.env.local --conditions=react-server --import tsx scripts/check-nessie.ts",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "seed:demo": "node --env-file=.env.local --conditions=react-server --import tsx scripts/seed-demo.ts",
    "test:db": "vitest run --config vitest.int.config.mts",
    "check:auth0": "node --env-file=.env.local scripts/check-auth0.mjs",
    "bench:perf": "node --import tsx scripts/perf-bench.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.32.1",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
