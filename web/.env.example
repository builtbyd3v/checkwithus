# Copy to .env.local and fill in. NEVER commit .env.local.
# cp .env.example .env.local

# --- Capital One Nessie ---------------------------------------------
# Get a key at nessieisreal.com. The client always uses HTTPS and sends the
# key as a ?key= query param, so it never logs a URL.
NESSIE_API_KEY=

# --- Auth0 ------------------------------------------------------------
# Bare hostname, e.g. your-tenant.us.auth0.com (no https://, no slash).
# Check the whole setup with: npm run check:auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 random bytes as 64 hex characters; encrypts dashboard session cookies.
AUTH0_SECRET=
# Identifier of the Auth0 API the family app requests tokens for. Must match
# the API's Identifier in the Auth0 dashboard exactly, trailing slash included.
AUTH0_AUDIENCE=
# Optional. `true`: Guardian pushes show amount, payee and hold reasons
# (Rich Authorization Requests). Register the type on the API first; see
# INTEGRATION.md. Empty or `false`: the short binding message only.
AUTH0_CIBA_RAR=
# Optional. `true`: approving needs `approve:payments` in the Auth0 token
# (RBAC on the API, "Add Permissions in the Access Token"); a token without the
# claim cannot approve. Guardian approvals are checked only with AUTH0_CIBA_RAR=true.
AUTH0_RBAC=
# Optional. The bill-pay agent's own Auth0 Machine-to-Machine application,
# authorized for this API with only the `pay:bills` scope (INTEGRATION.md).
# Empty: the agent route answers 503 agent_disabled. The secret is read only
# by `npm run agent:bills`, never by the API.
AUTH0_AGENT_CLIENT_ID=
AUTH0_AGENT_CLIENT_SECRET=

# --- Tiger Data (Tiger Cloud / Postgres) ------------------------------
# console.cloud.timescale.com -> service -> connection details.
# Both must end with ?sslmode=require
#
# Pooled (PgBouncer). Used by the app at runtime. Transaction-mode pooling,
# so no LISTEN/NOTIFY and no session-level state over this one.
DATABASE_URL=
# Direct (bypasses the pooler). Used by migrations only -- schema changes
# must not go through transaction pooling.
DIRECT_DATABASE_URL=

# --- Code hashing -----------------------------------------------------
# Key for hashing invite and pairing codes, so a leaked database cannot be
# brute-forced for working codes. 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CODE_HASH_KEY=

# --- App --------------------------------------------------------------
# Used to build absolute callback URLs. No trailing slash.
APP_BASE_URL=http://localhost:3000
# How long a family member has to answer before the payment is auto-blocked.
# 30-300; CIBA caps it at 300.
APPROVAL_TIMEOUT_SECONDS=300
# Optional. `app` (default): the family app calls the API after Face ID.
# `ciba`: Auth0 CIBA push (needs CIBA enabled on the tenant).
APPROVAL_MODE=app
# Optional. Calendar dates sent to Nessie use this zone.
DEMO_TIMEZONE=America/New_York
# Optional. Extra bank branches for the on-call bank alert, as JSON
# [{"name":"...","lat":29.6,"lng":-82.3}]. Nessie has no banks in Gainesville,
# so the expo needs one. Empty by default. Example in INTEGRATION.md.
DEMO_BANK_LOCATIONS=
