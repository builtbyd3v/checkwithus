# Copy to .env.local and fill in. NEVER commit .env.local.
# cp .env.example .env.local

# --- Capital One Nessie ---------------------------------------------
# http://api.nessieisreal.com/ -> "Get an API key". Instant, no review.
# Passed as a ?key= query param, not a header.
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com

# --- Auth0 ------------------------------------------------------------
# Tenant must have CIBA enabled (Enterprise feature - ask the Auth0 booth
# to flip it on, see notes in web/README.md).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Audience for the API that CIBA tokens are minted for.
AUTH0_AUDIENCE=

# --- Tiger Data (Tiger Cloud / Postgres) ------------------------------
# console.cloud.timescale.com -> service -> connection details.
# Both must end with ?sslmode=require
#
# Pooled (PgBouncer). Used by the app at runtime. Transaction-mode pooling,
# so no LISTEN/NOTIFY and no session-level state over this one.
DATABASE_URL=
# Direct (bypasses the pooler). Used by migrations only -- schema changes
# must not go through transaction pooling.
DIRECT_DATABASE_URL=

# --- App --------------------------------------------------------------
# Used to build absolute callback URLs. No trailing slash.
APP_BASE_URL=http://localhost:3000
# How long a family member has to answer before the payment is auto-blocked.
APPROVAL_TIMEOUT_SECONDS=300
